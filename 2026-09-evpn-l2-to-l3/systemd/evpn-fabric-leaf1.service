# /etc/systemd/system/evpn-fabric.service on leaf1
#
# The VXLAN dataplane is kernel state, not FRR config, so it does not survive
# a reboot on its own: the leaf comes back with BGP established and frr.conf
# intact, and no vxlan100 at all.
#
# Do NOT add Before=frr.service. frr.service declares Before=network.target,
# which closes the loop evpn-fabric -> network-online.target -> network.target
# -> frr.service -> evpn-fabric. systemd breaks an ordering cycle by deleting
# one job and picks a different victim per host: on 2026-08-27 leaf1 lost this
# unit entirely -- it reported 'enabled', never ran, and nothing was marked
# failed -- while leaf2 came up fine from an identical file.
# It is also unnecessary: zebra discovers VXLAN devices whenever they appear.
[Unit]
Description=EVPN VXLAN dataplane
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=UP=ens19
ExecStart=-/sbin/ip link add vxlan100 type vxlan id 100 dstport 4789 local 192.168.30.11 nolearning
ExecStart=-/sbin/ip link add br100 type bridge
ExecStart=/sbin/ip link set vxlan100 master br100
ExecStart=/sbin/ip link set ${UP} master br100
ExecStart=/sbin/ip link set vxlan100 mtu 1450
ExecStart=/sbin/ip link set br100 mtu 1450
ExecStart=/sbin/ip link set ${UP} mtu 1450
ExecStart=/sbin/ip link set vxlan100 up
ExecStart=/sbin/ip link set br100 up
ExecStart=/sbin/ip link set ${UP} up

# ---- L3: VRF and L3 VNI 101 (added for the L2->L3 step) ----
# Order matters: VRF first, then the VXLAN, then enslave.
ExecStart=-/sbin/ip link add tenant-a type vrf table 1001
ExecStart=/sbin/ip link set tenant-a up
ExecStart=-/sbin/ip link add vxlan101 type vxlan id 101 dstport 4789 local 192.168.30.11 nolearning
ExecStart=-/sbin/ip link add br101 type bridge
ExecStart=/sbin/ip link set vxlan101 master br101
ExecStart=/sbin/ip link set br101 master tenant-a
ExecStart=/sbin/ip link set vxlan101 mtu 1450
ExecStart=/sbin/ip link set br101 mtu 1450
ExecStart=/sbin/ip link set vxlan101 up
ExecStart=/sbin/ip link set br101 up

# ---- the anycast gateway: same IP and same MAC on BOTH leaves ----
# This is kernel state too, so it belongs here rather than in a script run
# by hand: without it a rebooted leaf comes back with the L2 fabric working
# and no gateway, no connected route in the VRF, and no Type-5 originated.
ExecStart=/sbin/ip link set br100 address 02:00:00:40:00:01
ExecStart=-/sbin/ip addr add 192.168.40.1/24 dev br100
ExecStart=/sbin/ip link set br100 master tenant-a

[Install]
WantedBy=multi-user.target
